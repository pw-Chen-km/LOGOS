# LOGOS 2.0 local environment template
# Copy to .env and fill values. .env is ignored by git.

# LLM planning via EvoScientist bridge
DEEPSEEK_API_KEY=

# Web research via EvoScientist Tavily tool
TAVILY_API_KEY=

# Paper discovery quality/rate limits
S2_API_KEY=

# Full-text/deep reading via Jina Reader
JINA_API_KEY=

# Optional: code/model/dataset search rate limits
GITHUB_TOKEN=
HF_TOKEN=

# Optional: override local paper cache location
# PAPERS_DIR=paper_library

# Optional: override paper-navigator skill path
# LOGOS_PAPER_NAVIGATOR_DIR=
